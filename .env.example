# Database
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Campus AI (AETHER) Feature Flags
AI_ASSISTANT_ENABLED="true"
DEMO_MODE_ENABLED="true"
NEXT_PUBLIC_DEMO_MODE="true"

# LLM Providers (Server-side only — Never exposed to browser)
# Falls back to local rule-based multilingual intent matcher if keys are omitted
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Optional AI College Logo Generation (Falls back automatically to offline SVG)
ENABLE_AI_LOGO_GENERATION="false"
